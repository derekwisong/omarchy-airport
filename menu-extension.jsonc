// Reach the airport lookup from the Omarchy menu (SUPER + SPACE) without
// spending a keybinding. "trigger" is where Omarchy keeps its one-shot
// surfaces - Emoji, Reminder, Capture - so the lookup belongs there too.
//
// Merge into ~/.config/omarchy/extensions/omarchy-menu.jsonc, which
// hot-reloads on save. Then it is reachable three ways:
//   SUPER + SPACE, then type "airport"
//   omarchy menu summon trigger.airports
//   omarchy menu summon metar        (via the aliases below)
{
  "trigger.airports": {
    "icon": "󰀝",
    "label": "Airports",
    "aliases": ["airport", "airports", "metar", "wx"],
    "description": "Look up any airport - runways, frequencies, weather, procedures",
    "action": "omarchy-shell shell toggle derekwisong.airport"
  }
}
